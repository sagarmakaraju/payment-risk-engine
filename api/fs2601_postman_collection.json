{
  "info": {
    "name": "FS-2601 Payment Authorization & Risk API v2.0",
    "description": "Comprehensive Postman Collection covering all core modules M1-M7 and production features F1-F5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accountId", "value": "ACC-BENCH-1" },
    { "key": "merchantId", "value": "MERCHANT-POS-01" },
    { "key": "terminalId", "value": "TERM-001" }
  ],
  "item": [
    {
      "name": "01. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/health" }
      }
    },
    {
      "name": "02. Query Account Balance (Dual-Bucket)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/account/{{accountId}}" }
      }
    },
    {
      "name": "03. Feature 1: Pre-Allocate Offline Allowance",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"amount\": 15000\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/ledger/allowance/allocate" }
      }
    },
    {
      "name": "04. Feature 3: Generate Dynamic QR (Genuine)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchant_id\": \"{{merchantId}}\",\n  \"terminal_id\": \"{{terminalId}}\",\n  \"tamper_mode\": \"NONE\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/qr/generate" }
      }
    },
    {
      "name": "05. Feature 3: Defeat Physical QR Sticker Attack (ISO 59)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"merchant_id\": \"{{merchantId}}\",\n  \"amount\": 2500,\n  \"dynamic_qr\": {\n    \"merchant_id\": \"ATTACKER-EVIL-MERCHANT\",\n    \"terminal_id\": \"{{terminalId}}\",\n    \"epoch_salt\": 1789200000,\n    \"nonce\": \"attackernonce\",\n    \"signature\": \"validsigforattackermerchant\"\n  }\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/auth/pay" }
      }
    },
    {
      "name": "06. Feature 2: Compact Cuckoo Revocation Stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/revocation/stats" }
      }
    },
    {
      "name": "07. Feature 2: Revoke Account in Cuckoo Filter",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_id\": \"ACC-REVOKED-POSTMAN\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/revocation/add" }
      }
    },
    {
      "name": "08. Issue Ed25519 Offline Token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"max_floor_amount\": 5000,\n  \"duration_sec\": 3600,\n  \"terminal_id\": \"{{terminalId}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/tokens/issue" }
      }
    },
    {
      "name": "09. Network Partition Cut (DISCONNECTED)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"DISCONNECTED\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/network/toggle" }
      }
    },
    {
      "name": "10. Reconnect & Deterministic Replay (RECONNECTED)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"RECONNECTED\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/network/toggle" }
      }
    },
    {
      "name": "11. Feature 5: Query Deficit Reserve Balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/ledger/reserve" }
      }
    },
    {
      "name": "12. Audit Global Double-Entry Conservation",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/audit/conservation" }
      }
    },
    {
      "name": "13. Create & Fund Customer Account",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_id\": \"ACC-CUSTOM-01\",\n  \"balance\": 100000,\n  \"offline_allowance\": 20000\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/account/create" }
      }
    },
    {
      "name": "14. Reset Graph Fraud Engine State",
      "request": {
        "method": "POST",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/fraud/reset" }
      }
    }
  ]
}
